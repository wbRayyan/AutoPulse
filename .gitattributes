# Normalize all text files to LF line endings (required for Docker/Linux containers)
* text=auto eol=lf

# Windows-only scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files must never be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary